#!/usr/bin/env bash
# kind: decide
#
# overseer-vision — where the owner's vision skill is: print the absolute
# path of a SKILL.md that meets docs/vision-spec.md. /lv-vision reads that
# file and follows it.
#
# Args: none. Stdin: none. Exit 0 with the path, or 3 when there is none —
# /lv-vision then offers to interview the owner and write one.
#
# This default looks for .claude/skills/vision/SKILL.md in the project, which
# is where /lv-vision writes a generated skill.
root="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
f="$root/.claude/skills/vision/SKILL.md"
[ -f "$f" ] || { echo "overseer-vision: no vision skill (looked for $f)" >&2; exit 3; }
printf '%s\n' "$f"

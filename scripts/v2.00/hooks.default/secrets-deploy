#!/usr/bin/env bash
# kind: decide
#
# secrets-deploy <id> <location> [<id> <location> ...] — set archived secrets
# on a deployed app without printing a value. What an id and a location are
# is the implementing tool's business; the contract is only that nothing
# secret reaches stdout, stderr or argv.
#
# Exit 0 when every location was set. This default has no secrets tool, so it
# refuses with 3 and says where one comes from.
echo "secrets-deploy: no secrets tool is configured. Add a pack with hooks/secrets-deploy (see lv-hook.sh --help)." >&2
exit 3

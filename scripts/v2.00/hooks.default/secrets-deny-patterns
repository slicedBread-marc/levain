#!/usr/bin/env bash
# kind: add-deny
#
# secrets-deny-patterns — where YOUR secrets live and which command reveals
# one, added to the permission baseline (lv-guard-baseline.sh refuses them to
# unattended workers; settings-merge.py denies the paths to every session).
#
# Args: none. Stdin: none. Exit 0, or non-zero to refuse everything (fail
# closed). Stdout: one rule per line, tab-separated:
#
#   path<TAB><path>                         a secret file or directory; `~/` ok
#   command<TAB><rule-id><TAB><regex><TAB><why>
#                                           a Bash command to refuse; <regex> is
#                                           Python, matched from the start of each
#                                           simple command: its name reduced to a
#                                           basename, sudo/env/VAR= dropped, words
#                                           joined by one space. $(...), `...`,
#                                           bash -c/eval/ssh strings and shell
#                                           heredocs are commands too; a quoted
#                                           argument is not. <rule-id> is what
#                                           permissionBaseline.allow lifts
#
# The library's own rules (.env files, private keys, ~/.ssh, git force-push,
# …) are built into the guard and cannot be removed by any layer. This default
# adds nothing: the library cannot know where your secrets tool keeps its keys.
exit 0
